{
  "name": "no-website-leads",
  "version": "1.0.0",
  "description": "Finds local businesses without a website using the Google Places API, so J&O Studios can build an outreach list of prospects who need a site.",
  "type": "module",
  "private": true,
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "leads:find": "node scripts/find-leads.mjs",
    "outreach:send": "node scripts/send-outreach.mjs",
    "gmail:auth": "node scripts/gmail-auth.mjs",
    "audit:site": "node scripts/audit-site.mjs"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "googleapis": "^144.0.0",
    "stripe": "^18.0.0"
  }
}
