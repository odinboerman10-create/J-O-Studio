# Get a key at https://console.cloud.google.com/ with the "Places API (New)" enabled.
GOOGLE_PLACES_API_KEY=

# Port for the local server (optional)
PORT=3000

# Stripe (test mode) — https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# From `stripe listen` (Stripe CLI) locally, or the webhook endpoint's signing secret in the Dashboard once deployed.
STRIPE_WEBHOOK_SECRET=

# --- Outreach automation ---

# https://console.anthropic.com/settings/keys — used to draft personalized outreach emails.
ANTHROPIC_API_KEY=
# Optional override; defaults to a fast/cheap model.
OUTREACH_MODEL=claude-haiku-4-5-20251001

# Gmail sending — see scripts/gmail-auth.mjs for one-time setup instructions.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=

# Shown in every outreach email — CAN-SPAM requires a real physical mailing address
# in every commercial email. The send script refuses to run without this set.
OUTREACH_MAILING_ADDRESS=
OUTREACH_SENDER_NAME=J&O Studios
# Safety cap on how many outreach emails one run will send.
OUTREACH_MAX_PER_RUN=15
