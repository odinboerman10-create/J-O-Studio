# Get a key at https://console.cloud.google.com/ with the "Places API (New)" enabled.
GOOGLE_PLACES_API_KEY=

# Port for the local server (optional)
PORT=3000

# Stripe (test mode) — https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# From `stripe listen` (Stripe CLI) locally, or the webhook endpoint's signing secret in the Dashboard once deployed.
STRIPE_WEBHOOK_SECRET=
