# Get a key at https://console.cloud.google.com/ with the "Places API (New)" enabled.
GOOGLE_PLACES_API_KEY=

# Port for the local server (optional)
PORT=3000

# Optional: set both to require a login (HTTP Basic Auth) on every request.
# Strongly recommended for any deployment reachable off your own machine —
# without this, anyone with the URL can read/edit/delete your leads and
# spend your Google Places API quota. Leave blank for local-only use.
APP_USERNAME=
APP_PASSWORD=
