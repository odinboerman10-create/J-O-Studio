# Get a key at https://console.cloud.google.com/ with the "Places API (New)" enabled.
GOOGLE_PLACES_API_KEY=

# Port for the local server (optional)
PORT=3000

# Stripe (test mode) — https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# From `stripe listen` (Stripe CLI) locally, or the webhook endpoint's signing secret in the Dashboard once deployed.
STRIPE_WEBHOOK_SECRET=

# --- Outreach automation ---

# https://console.anthropic.com/settings/keys — used to draft personalized outreach emails.
ANTHROPIC_API_KEY=
# Optional override; defaults to a fast/cheap model.
OUTREACH_MODEL=claude-haiku-4-5-20251001

# Gmail sending — see scripts/gmail-auth.mjs for one-time setup instructions.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=

# Shown in every outreach email — CAN-SPAM requires a real physical mailing address
# in every commercial email. The send script refuses to run without this set.
OUTREACH_MAILING_ADDRESS=
OUTREACH_SENDER_NAME=J&O Studios
# Safety cap on how many outreach emails one run will send.
OUTREACH_MAX_PER_RUN=15

# --- Content audit ---

# Optional override for the site-audit critique model; defaults to ANTHROPIC_API_KEY's
# model above (OUTREACH_MODEL), then a fast/cheap default.
AUDIT_MODEL=claude-haiku-4-5-20251001

# --- Contact enrichment (Apollo) ---

# https://app.apollo.io → Settings → Integrations → API. Spends real Apollo
# lead credits (roughly 1 per revealed email) — check your dashboard for
# current pricing/balance before turning on scheduled runs.
APOLLO_API_KEY=
# Only override if Apollo's documented API base path changes.
APOLLO_API_BASE=https://api.apollo.io/api/v1
# Comma-separated job titles to search for at each business, in priority order.
ENRICH_TARGET_TITLES=Owner,Founder,Co-Founder,President,CEO,General Manager,Managing Partner,Operations Manager
# Safety cap on how many leads one run will attempt to enrich (= credits spent).
ENRICH_MAX_PER_RUN=10
