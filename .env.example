# Get a key at https://console.cloud.google.com/ with the "Places API (New)" enabled.
GOOGLE_PLACES_API_KEY=

# Port for the local server (optional)
PORT=3000

# Cold email outreach — get a key at https://resend.com/api-keys
RESEND_API_KEY=

# Must be an address on a domain you've verified in Resend, e.g. "J&O Studios <hello@yourdomain.com>"
EMAIL_FROM=

# Optional: where replies should go if different from EMAIL_FROM
EMAIL_REPLY_TO=

# Optional: shown in the sign-off and required footer of every outreach email
SENDER_NAME=The J&O Studios team

# Optional but recommended for CAN-SPAM compliance: a real postal address for your business
EMAIL_FOOTER_ADDRESS=
